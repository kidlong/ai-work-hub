# ==== Chung ====
APP_ENV=dev
TIMEZONE=Asia/Ho_Chi_Minh
# Bắt buộc đổi ở production (>= 32 ký tự ngẫu nhiên, lấy từ Vault/secret store)
JWT_SECRET=change-me-to-a-long-random-secret-from-vault
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_HOURS=8
DATABASE_URL=sqlite:///./aiworkhub.db
# DATABASE_URL=postgresql+psycopg://aiworkhub:aiworkhub@postgres:5432/aiworkhub
CORS_ORIGINS=*

# ==== Chế độ MOCK: chạy end-to-end không cần hệ thống thật ====
# true = mọi connector trả dữ liệu mẫu; false = gọi hệ thống thật (cấu hình bên dưới)
MOCK_CONNECTORS=true
# mock = đăng nhập bằng user demo (mật khẩu: demo); ldap = xác thực Active Directory
AUTH_MODE=mock

# ==== Active Directory (LDAP) ====
LDAP_URL=ldaps://dc01.bank.local:636
LDAP_DOMAIN=BANK.LOCAL
LDAP_BASE_DN=DC=bank,DC=local
LDAP_CA_CERT_FILE=

# ==== Exchange on-prem (EWS) ====
EXCHANGE_ENABLED=true
EXCHANGE_EWS_URL=https://mail.bank.local/EWS/Exchange.asmx
# Service account có role ApplicationImpersonation (giới hạn scope bằng management scope)
EXCHANGE_SERVICE_USER=BANK\svc-aiworkhub
EXCHANGE_SERVICE_PASSWORD=
EXCHANGE_AUTH_TYPE=NTLM
EXCHANGE_CA_CERT_FILE=

# ==== Jira Data Center ====
JIRA_ENABLED=true
JIRA_BASE_URL=https://jira.bank.local
JIRA_TOKEN=
# ==== Confluence Data Center ====
CONFLUENCE_ENABLED=true
CONFLUENCE_BASE_URL=https://wiki.bank.local
CONFLUENCE_TOKEN=

# ==== ManageEngine ServiceDesk Plus on-prem (API v3) ====
SDP_ENABLED=true
SDP_BASE_URL=https://sdp.bank.local
SDP_AUTHTOKEN=

# ==== Microsoft Teams (Microsoft Graph - cloud, cần egress) ====
TEAMS_ENABLED=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ==== CA nội bộ cho HTTPS tới các hệ thống on-prem ====
INTERNAL_CA_BUNDLE=

# ==== LLM on-prem (OpenAI-compatible: vLLM / Ollama / TGI) ====
LLM_ENABLED=false
LLM_BASE_URL=http://llm.bank.local:8000
LLM_API_KEY=
LLM_MODEL=qwen2.5-14b-instruct
LLM_TIMEOUT_SECONDS=45

# ==== Push ====
# log = chỉ ghi log; fcm = Firebase Cloud Messaging HTTP v1 (qua egress proxy)
PUSH_PROVIDER=log
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# false = push không chứa nội dung nghiệp vụ (khuyến nghị cho ngân hàng)
PUSH_INCLUDE_CONTENT=false

# ==== Worker ====
SYNC_INTERVAL_MINUTES=5
